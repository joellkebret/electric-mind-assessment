# SQLite file created on startup. Uncomment to override the default path
# under backend/solution/data/portfolio.db.
# DATABASE_URL=sqlite:///C:/absolute/path/to/portfolio.db

# Mock CRM from backend/mock-crm.mjs
CRM_BASE_URL=http://localhost:4002
CRM_TIMEOUT_SECONDS=3

# Accepted by the auth middleware once that route guard is added.
API_TOKEN=superday-demo-token
